{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic agent-harness compiler: turn stack + architecture + style + safety intent into enforced agent configuration",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r build",
    "lint": "eslint packages --ext ts",
    "verify": "node .keel/verify.mjs",
    "keel:check": "node packages/cli/dist/index.js check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
